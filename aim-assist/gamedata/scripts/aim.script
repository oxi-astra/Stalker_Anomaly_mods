
local zoom_in = false
local LastTarget = nil
local turn_on = true
weapon_black_list = {}

-------------------------------------------------MCM stuff--------------------------------------------------------------------------------

local get_config = aim_mcm.get_config

function translate_bone(number)
	local bone_guide = {
		[1] = "bip01_head",
		[2] = "bip01_neck",
		[3] = "bip01_spine",
	}
	return bone_guide[number]
end

function on_option_change()
	bone = translate_bone( get_config("main_bone") )
	work_state = get_config("work_state")
	keybind = get_config("ui_keybind")
	
	time_out_checkbox = get_config("time_out_checkbox")
	time_out_input = get_config("time_out_input")
	
	limit_mode = get_config("limit_mode")
	limit_value = get_config("limit_value")
	
	trigger_zone_default = get_config("radius")
	trigger_zone = trigger_zone_default
	
	frendly_fire = get_config("frendly_fire")
	
	closer_wider = get_config("closer_wider")
	closer_wider_value = get_config("closer_wider_value")
	closer_wider_distance = get_config("closer_wider_distance")
	
	weapon_black_list = {
		["w_pistol"] = get_config("wbl_pistols"),
		["w_smg"] = get_config("wbl_smg"),
		["w_rifle"] = get_config("wbl_rifle"),
		["w_shotgun"] = get_config("wbl_shotgun"),
		["w_sniper"] = get_config("wbl_snipe"),
		["w_explosive"] = get_config("wbl_explosive")
	}
	
	if work_state == 0 then
		UnregisterScriptCallback("actor_on_update", aim_assist)
		LastTarget = nil
	end
end

local function limit_equation(obj)
	return limit_mode == 0 or
	(limit_mode == -1) and (distance_between_safe(db.actor, obj) <= limit_value) or 
	(limit_mode == 1) and (distance_between_safe(db.actor, obj) >= limit_value)
end

local function IsAllowedWeapon()
	wpn = db.actor:active_item()
	if wpn and IsWeapon(wpn) then 
		return weapon_black_list[ini_sys:r_string_ex(wpn:section(),"kind")] or nil
	end
	return false
end

local function print_dbg(msg, num)
	printf(string.format("- [aim.script] | ") .. msg, num)
end

---------------------------------------------main------------------------------------------------------------------------------------

function dot_eye(position)
	local toPoint = vector():set(position):sub(device().cam_pos):normalize()
	local toEye = device().cam_dir
	local dot = toPoint:dotproduct(toEye)
	return dot
end

local function pos_y(obj)
	if not(obj) then return end
	local pos = vector():set(obj:position())
	pos.y = pos.y + 1
	return pos
end

function is_valid_object(obj)
	if not(obj) then return end
	if not limit_equation(obj) then return end
	
	if ( (frendly_fire and IsStalker(obj)) or 
	(IsStalker(obj) and (obj:relation(db.actor) >= game_object.enemy)) or 
	IsMonster(obj) ) and 
	obj:alive() and db.actor:see(obj) or
	IsHelicopter(obj) and obj:alive()
	then
		return true
	else 
		return 
	end
end

function dot_check(obj)
	if not(obj) then return end
	
	local pos = obj:get_bone_id(bone) == 65535 and pos_y(obj) or utils_obj.safe_bone_pos(obj, bone)
	local dot = dot_eye(pos)

	if closer_wider and distance_between_safe(db.actor, obj) <= closer_wider_distance then
		trigger_zone = closer_wider_value
	else
		trigger_zone = trigger_zone_default
	end

	if dot and dot >= trigger_zone then
		return dot
	else
		return nil
	end
end

function search_target()
    local t = db.storage
    local best_dot = -1
    local best_target = nil

    for id, st in pairs(t) do
        if st.object and is_valid_object(st.object) then
            local dot = dot_check(st.object)
            if dot and dot > best_dot then
                best_dot = dot
                best_target = st.object
            end
        end
    end

    LastTarget = best_target
end

function trace_target(obj)
	if not(obj) then return end
	local pos = obj:get_bone_id(bone) == 65535 and pos_y(obj) or utils_obj.safe_bone_pos(obj, bone)
	db.actor:actor_look_at_point(pos)
end

function aim_assist()
	local wpn = db.actor:active_item()
	if wpn and IsWeapon(wpn) then
		local obj = level.get_target_obj()
		if obj and is_valid_object(obj) then
			LastTarget = obj
			trace_target(obj)
		elseif LastTarget and is_valid_object(LastTarget) and dot_check(LastTarget) then
			trace_target(LastTarget)
		else
			db.actor:actor_stop_look_at_point()
			search_target()
		end
	else
		return
	end
end

-----------------------------------------------------------work states----------------------------------------------------------------------------------------------------

function actor_on_weapon_zoom_in()
	turn_on = true
	zoom_in = true
	if work_state == 1 and IsAllowedWeapon() then
		RegisterScriptCallback("actor_on_update", aim_assist)
		if time_out_checkbox then
			CreateTimeEvent("time_out_ev", "time_out_act", time_out_input, function()
				UnregisterScriptCallback("actor_on_update", aim_assist)
				db.actor:actor_stop_look_at_point()
				LastTarget = nil
				RemoveTimeEvent("time_out_ev", "time_out_act")
			end)
		end
	end
end

function actor_on_weapon_zoom_out()
	zoom_in = false
	turn_on = true
	if (work_state == 1) then
		UnregisterScriptCallback("actor_on_update", aim_assist)
		db.actor:actor_stop_look_at_point()
		LastTarget = nil
	end
end

function on_key_hold(key)
	if (work_state == 2) and (key == keybind) and IsAllowedWeapon() then
		RegisterScriptCallback("actor_on_update", aim_assist)
	end
end

function on_key_release(key)
	if (work_state == 2) and (key == keybind) then
		UnregisterScriptCallback("actor_on_update", aim_assist)
		db.actor:actor_stop_look_at_point()
		LastTarget = nil
	end
end

function open_fire(key)
	if (work_state ~= 3) then return end
	
    local wpn = db.actor:active_item()
    if not wpn then return end

	local bind = dik_to_bind(key)
    if (bind == key_bindings.kWPN_FIRE) and IsAllowedWeapon() then
        RegisterScriptCallback("actor_on_update", aim_assist)
	end
end

function hold_fire(key)
	if (work_state ~= 3) then return end
	
	local wpn = db.actor:active_item()
    if not wpn then return end

	local bind = dik_to_bind(key)
    if (bind == key_bindings.kWPN_FIRE) then
		UnregisterScriptCallback("actor_on_update", aim_assist)
		db.actor:actor_stop_look_at_point()
		LastTarget = nil
	end
end

function on_key_press(key)
	if (key == keybind) and (work_state == 1) then
		turn_on = not(turn_on)
		
		if zoom_in and turn_on then
			RegisterScriptCallback("actor_on_update", aim_assist)
		elseif zoom_in and not(turn_on) then
			UnregisterScriptCallback("actor_on_update", aim_assist)
			db.actor:actor_stop_look_at_point()
			LastTarget = nil
		end
	end
end

function delete_LastTarger(npc)
	if LastTarget and LastTarget:id() == npc:id() then
		LastTarget = nil
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_weapon_zoom_in", actor_on_weapon_zoom_in)
	RegisterScriptCallback("actor_on_weapon_zoom_out", actor_on_weapon_zoom_out)
	RegisterScriptCallback("actor_on_weapon_lower", actor_on_weapon_zoom_out)
	RegisterScriptCallback("on_key_hold", on_key_hold)
	RegisterScriptCallback("on_key_release", on_key_release)
	RegisterScriptCallback("on_key_hold", open_fire)
	RegisterScriptCallback("on_key_release", hold_fire)
	RegisterScriptCallback("on_key_press",on_key_press)
	RegisterScriptCallback("npc_on_net_destroy", delete_LastTarger)
	RegisterScriptCallback("monster_on_net_destroy", delete_LastTarger)
	RegisterScriptCallback("npc_on_death_callback", delete_LastTarger)
	RegisterScriptCallback("monster_on_death_callback", delete_LastTarger)
	RegisterScriptCallback("on_option_change", on_option_change)
	on_option_change()
end